# APP_DIR을 서버의 실제 경로로 바꿔 /etc/logrotate.d/nginx-app 에 둔다(docs/deployment.md)
APP_DIR/nginx/logs/*.log {
    daily
    rotate 90
    maxage 90
    dateext
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        docker kill --signal=USR1 nginx >/dev/null 2>&1 || true
    endscript
}
