{
  "uid": "logs",
  "title": "Logs",
  "tags": ["nest"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values(env)",
        "query": {
          "type": 1,
          "label": "env",
          "stream": "",
          "refId": "env"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "production",
          "value": "production"
        }
      },
      {
        "name": "level",
        "label": "레벨",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({env=\"$env\", job=\"nest\"}, level)",
        "query": {
          "type": 1,
          "label": "level",
          "stream": "{env=\"$env\", job=\"nest\"}",
          "refId": "level"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "sort": 1,
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        }
      },
      {
        "name": "traceId",
        "label": "traceId",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "search",
        "label": "검색어",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "레벨별 로그 수",
      "description": "구간별 로그 줄 수. 레벨·traceId·검색어 필터가 적용된다.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({env=\"$env\", job=\"nest\", level=~\"$level\"} |= \"$search\" | trace_id=~\"$traceId.*\" [$__interval]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "에러 로그",
      "description": "level=error 로그. 상단 필터와 무관하게 항상 보인다. 로그를 펼쳐 trace_id를 누르면 그 요청의 로그만 모아 본다.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{env=\"$env\", job=\"nest\", level=\"error\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "전체 로그",
      "description": "레벨·traceId·검색어 필터가 적용된 로그. 로그를 펼쳐 trace_id를 누르면 그 요청의 로그만 모아 본다.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{env=\"$env\", job=\"nest\", level=~\"$level\"} |= \"$search\" | trace_id=~\"$traceId.*\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
