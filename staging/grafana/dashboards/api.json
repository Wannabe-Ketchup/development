{
  "uid": "api",
  "title": "API",
  "tags": [
    "nest"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up{job=\"nest\"}, env)",
        "query": { "query": "label_values(up{job=\"nest\"}, env)", "refId": "env" },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": { "text": "production", "value": "production" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "초당 요청 수",
      "description": "route별 초당 HTTP 요청 수 (/health 제외)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, route) (rate(http_requests_total{job=\"nest\",env=\"$env\",route!=\"/health\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx 비율",
      "description": "전체 요청 중 서버 에러(5xx) 응답 비율 (/health 제외). 요청이 없으면 비어 있다",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{job=\"nest\",env=\"$env\",route!=\"/health\",status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_requests_total{job=\"nest\",env=\"$env\",route!=\"/health\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "평균 응답시간",
      "description": "전체 HTTP 요청의 평균 응답시간 (/health 제외)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_sum{job=\"nest\",env=\"$env\",route!=\"/health\"}[$__rate_interval])) / sum(rate(http_request_duration_seconds_count{job=\"nest\",env=\"$env\",route!=\"/health\"}[$__rate_interval]))",
          "legendFormat": "평균"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_sum{job=\"nest\",env=\"$env\",route=\"/health\"}[$__rate_interval])) / sum(rate(http_request_duration_seconds_count{job=\"nest\",env=\"$env\",route=\"/health\"}[$__rate_interval]))",
          "legendFormat": "/health (기준선)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 응답시간",
      "description": "요청 95%가 이 시간 안에 응답했다 (/health 제외). 버킷 경계 사이 값은 보간된 추정치",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"nest\",env=\"$env\",route!=\"/health\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "SSE 연결 수",
      "description": "현재 연결된 SSE 클라이언트 수",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sse_connections_active{job=\"nest\",env=\"$env\"}",
          "legendFormat": "연결 수"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SSE 이벤트 전송량",
      "description": "이벤트 타입별 초당 전송 수 (클라이언트별로 집계: 4명에게 1번 보내면 4). heartbeat는 빼고 그린다. 연결 수 ÷ 15초로 거의 정해지고, 함께 그리면 다른 선이 바닥에 깔린다",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (type) (rate(sse_events_sent_total{job=\"nest\",env=\"$env\",type!=\"heartbeat\"}[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "채팅",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "채팅 전송 수 (분당)",
      "description": "1분 동안 성공(201)한 채팅 전송 요청 수. 응답을 못 받아 다시 보낸 요청도 성공으로 세므로 저장된 메시지 수보다 조금 많을 수 있다",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"nest\",env=\"$env\",method=\"POST\",route=\"/pomodoro/room/:roomId/chat-message\",status_code=\"201\"}[$__rate_interval])) * 60",
          "legendFormat": "전송"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "채팅 전송 p95",
      "description": "성공(201)한 채팅 전송 요청의 95%가 이 시간 안에 응답했다. 같은 방 연결에 메시지를 넘기는 일까지 요청 안에서 하므로 그 시간도 들어간다. 받는 사람 화면에 보일 때까지의 시간은 아니다. 전송이 적으면 한두 건에 크게 흔들리고, 없으면 비어 있다. 버킷 경계 사이 값은 보간된 추정치",
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"nest\",env=\"$env\",method=\"POST\",route=\"/pomodoro/room/:roomId/chat-message\",status_code=\"201\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "채팅 전송 실패 비율",
      "description": "채팅 전송 요청 중 실패한 비율을 status별로 나눈다. 429는 10초에 10건 제한, 404는 없는 방이거나 방에 없는 참여자, 400은 잘못된 요청 본문이다. 서버까지 오지 못한 실패(네트워크 끊김, 화면의 10초 시간 초과)는 포함되지 않는다. 실패가 한 건도 없으면 비어 있다",
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status_code) (rate(http_requests_total{job=\"nest\",env=\"$env\",method=\"POST\",route=\"/pomodoro/room/:roomId/chat-message\",status_code!=\"201\"}[$__rate_interval])) / ignoring(status_code) group_left sum(rate(http_requests_total{job=\"nest\",env=\"$env\",method=\"POST\",route=\"/pomodoro/room/:roomId/chat-message\"}[$__rate_interval]))",
          "legendFormat": "{{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "채팅 전송 시간 구성 (평균)",
      "description": "채팅 전송 요청(POST) 평균 시간을 두 부분으로 쌓아 그린다. 전체 높이가 POST 평균이다. 나눠 주기는 같은 방 연결에 메시지를 넘기는 시간(서버 전체 연결의 filter, JSON 변환, 응답 쓰기)이고, 나머지는 그 밖의 요청 처리(미들웨어, 검증, 저장)다. 나머지는 POST 평균에서 나눠 주기 평균을 뺀 값이라 다시 보낸 요청(나눠 주지 않음)이 섞이면 조금 작게 나온다. nginx와 네트워크 시간, 받는 사람 화면에 보일 때까지의 시간은 들어가지 않는다",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(sse_emit_duration_seconds_sum{job=\"nest\",env=\"$env\",type=\"chat_message\"}[$__rate_interval])) / sum(rate(sse_emit_duration_seconds_count{job=\"nest\",env=\"$env\",type=\"chat_message\"}[$__rate_interval]))",
          "legendFormat": "나눠 주기"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_request_duration_seconds_sum{job=\"nest\",env=\"$env\",method=\"POST\",route=\"/pomodoro/room/:roomId/chat-message\",status_code=\"201\"}[$__rate_interval])) / sum(rate(http_request_duration_seconds_count{job=\"nest\",env=\"$env\",method=\"POST\",route=\"/pomodoro/room/:roomId/chat-message\",status_code=\"201\"}[$__rate_interval]))) - (sum(rate(sse_emit_duration_seconds_sum{job=\"nest\",env=\"$env\",type=\"chat_message\"}[$__rate_interval])) / sum(rate(sse_emit_duration_seconds_count{job=\"nest\",env=\"$env\",type=\"chat_message\"}[$__rate_interval])))",
          "legendFormat": "나머지 (요청 처리·검증·저장)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
