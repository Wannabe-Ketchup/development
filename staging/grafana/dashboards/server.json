{
  "uid": "server",
  "title": "Server",
  "description": "운영 서버 전체의 메모리·스왑·CPU·디스크 (node exporter). staging 서버는 수집하지 않는다.",
  "tags": [
    "server"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "수집 상태",
      "description": "Prometheus가 운영 서버의 node exporter를 수집할 수 있는지 (1 = UP, 0 = DOWN). DOWN이면 다른 패널이 비어도 서버 문제가 아니라 수집이 끊긴 것일 수 있다",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"node\",env=\"production\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "OOM 종료",
      "description": "고른 기간 동안 커널이 메모리 부족(OOM)으로 프로세스를 강제로 끈 횟수. 1 이상이면 nest가 갑자기 재시작한 이유일 수 있다",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(node_vmstat_oom_kill{job=\"node\",env=\"production\"}[$__range])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "디스크 남은 용량",
      "description": "서버 디스크(/)에서 남은 비율. 로그·도커 이미지가 쌓여 줄어든다. 꽉 차면 스왑과 로그 기록도 실패한다",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_filesystem_avail_bytes{job=\"node\",env=\"production\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node\",env=\"production\",mountpoint=\"/\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "메모리 사용량",
      "description": "사용 중: 전체에서 새로 쓸 수 있는 양(MemAvailable)을 뺀 값. 전체에 가까워지면 스왑으로 밀려나기 시작한다",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemTotal_bytes{job=\"node\",env=\"production\"} - node_memory_MemAvailable_bytes{job=\"node\",env=\"production\"}",
          "legendFormat": "사용 중"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemTotal_bytes{job=\"node\",env=\"production\"}",
          "legendFormat": "전체"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "스왑 사용량",
      "description": "메모리가 모자라 디스크(스왑)로 옮겨 둔 양. 높아도 쓰기·읽기가 없으면 느려지지 않는다. 다시 꺼낼 일이 없으면 잘 줄지 않는다",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_SwapTotal_bytes{job=\"node\",env=\"production\"} - node_memory_SwapFree_bytes{job=\"node\",env=\"production\"}",
          "legendFormat": "사용 중"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_SwapTotal_bytes{job=\"node\",env=\"production\"}",
          "legendFormat": "전체"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "스왑 쓰기·읽기 (초당)",
      "description": "쓰기: 메모리 → 디스크로 내보냄 / 읽기: 디스크 → 메모리로 다시 가져옴. 계속 높으면 메모리가 모자라 서버가 느려지는 중이다 (1 페이지 = 보통 4KB)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_vmstat_pswpout{job=\"node\",env=\"production\"}[$__rate_interval])",
          "legendFormat": "쓰기"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_vmstat_pswpin{job=\"node\",env=\"production\"}[$__rate_interval])",
          "legendFormat": "읽기"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 페이지/초",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "메모리·디스크 때문에 멈춘 시간",
      "description": "1초 중 작업이 메모리(또는 디스크)를 기다리느라 멈춰 있던 비율. 메모리 쪽이 올라가면 \"서버 느려짐\"의 원인이 메모리 부족이다",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_pressure_memory_waiting_seconds_total{job=\"node\",env=\"production\"}[$__rate_interval])",
          "legendFormat": "메모리"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_pressure_io_waiting_seconds_total{job=\"node\",env=\"production\"}[$__rate_interval])",
          "legendFormat": "디스크"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU 사용률",
      "description": "서버 전체 CPU 중 쓰인 비율 (1 = 모든 코어 100%). iowait는 CPU가 디스크를 기다린 시간이라, 이게 크면 원인은 CPU가 아니라 디스크(스왑 포함)다",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (mode) (rate(node_cpu_seconds_total{job=\"node\",env=\"production\",mode=~\"user|system|iowait\"}[$__rate_interval]))",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      }
    }
  ]
}
